@lang.base

# Agam Base Profile: Sieve of Eratosthenes
# Direct integer bit manipulation with linear memory scan

fn count_primes(limit: i32) -> i32:
    let mut count = 0
    let mut i = 2
    while i < limit:
        let mut is_prime = 1
        let mut d = 2
        while d * d <= i:
            if i % d == 0:
                is_prime = 0
                break
            d = d + 1
        if is_prime == 1:
            count = count + 1
        i = i + 1
    return count

fn main() -> i32:
    let total = count_primes(20000)
    print_int(total)
    return 0
