root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2

[*.{ps1,bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab

[justfile]
indent_size = 4
