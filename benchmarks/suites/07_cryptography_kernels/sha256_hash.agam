@lang.advance

fn rotr32(x: i64, n: i64) -> i64 {
    let mask: i64 = 4294967295;
    let xm: i64 = x & mask;
    return ((xm >> n) | (xm << (32 - n))) & mask;
}

fn sha256_checksum(blocks: i64) -> i64 {
    let h0: i64 = 1779033703;
    let h1: i64 = 3144134277;
    let h2: i64 = 1013904242;
    let h3: i64 = 2773480762;
    let h4: i64 = 1359893119;
    let h5: i64 = 2600822924;
    let h6: i64 = 528734635;
    let h7: i64 = 1541459225;
    let mask: i64 = 4294967295;
    let checksum: i64 = 0;
    let b: i64 = 0;
    while b < blocks {
        let a: i64 = h0;
        let bv: i64 = h1;
        let c: i64 = h2;
        let d: i64 = h3;
        let e: i64 = h4;
        let f: i64 = h5;
        let g: i64 = h6;
        let hv: i64 = h7;
        let round: i64 = 0;
        while round < 64 {
            let w: i64 = (b * 64 + round) * 1103515245 + 12345;
            let s1: i64 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
            let ch: i64 = (e & f) ^ ((mask ^ e) & g);
            let temp1: i64 = (hv + s1 + (ch & mask) + (w & mask) + round * 7) & mask;
            let s0: i64 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
            let maj: i64 = (a & bv) ^ (a & c) ^ (bv & c);
            let temp2: i64 = (s0 + (maj & mask)) & mask;
            hv = g;
            g = f;
            f = e;
            e = (d + temp1) & mask;
            d = c;
            c = bv;
            bv = a;
            a = (temp1 + temp2) & mask;
            round = round + 1;
        }
        checksum = (checksum * 31 + a + bv + e + hv) % 1000000007;
        b = b + 1;
    }
    return checksum;
}

fn main() -> i32 {
    print_int(sha256_checksum(256));
    return 0;
}
