@lang.advance

fn crc32_checksum(data_size: i64) -> i64 {
    let crc: i64 = 4294967295;
    let mask: i64 = 4294967295;
    let poly: i64 = 3988292384;
    let i: i64 = 0;
    while i < data_size {
        let byte_val: i64 = (i * 1103515245 + 12345) & 255;
        crc = crc ^ byte_val;
        let bit: i64 = 0;
        while bit < 8 {
            if (crc & 1) != 0 {
                crc = ((crc >> 1) & (mask >> 1)) ^ poly;
            } else {
                crc = (crc >> 1) & (mask >> 1);
            }
            bit = bit + 1;
        }
        i = i + 1;
    }
    return (crc ^ mask) % 1000000007;
}

fn main() -> i32 {
    print_int(crc32_checksum(16384));
    return 0;
}
