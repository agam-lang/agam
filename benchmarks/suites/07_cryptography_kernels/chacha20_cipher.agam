@lang.advance

fn chacha_quarter(a: i64, b: i64, c: i64, d: i64) -> i64 {
    let mask: i64 = 4294967295;
    let av: i64 = (a + b) & mask;
    let dv: i64 = ((d ^ av) << 16 | ((d ^ av) & mask) >> 16) & mask;
    let cv: i64 = (c + dv) & mask;
    let bv: i64 = ((b ^ cv) << 12 | ((b ^ cv) & mask) >> 20) & mask;
    let av2: i64 = (av + bv) & mask;
    let dv2: i64 = ((dv ^ av2) << 8 | ((dv ^ av2) & mask) >> 24) & mask;
    let cv2: i64 = (cv + dv2) & mask;
    let bv2: i64 = ((bv ^ cv2) << 7 | ((bv ^ cv2) & mask) >> 25) & mask;
    return (av2 + bv2 + cv2 + dv2) & mask;
}

fn chacha20_checksum(rounds: i64) -> i64 {
    let checksum: i64 = 0;
    let i: i64 = 0;
    while i < rounds {
        let s0: i64 = 1634760805;
        let s1: i64 = 857760878;
        let s2: i64 = 2036477234;
        let s3: i64 = 1797285236;
        let r: i64 = 0;
        while r < 10 {
            let q1: i64 = chacha_quarter(s0, s1, s2, s3);
            let q2: i64 = chacha_quarter(s1 + i, s2 + r, s3, s0);
            let q3: i64 = chacha_quarter(s2, s3 + i, s0 + r, s1);
            let q4: i64 = chacha_quarter(s3, s0, s1 + i, s2 + r);
            s0 = q1;
            s1 = q2;
            s2 = q3;
            s3 = q4;
            r = r + 1;
        }
        checksum = (checksum * 37 + s0 + s1 + s2 + s3) % 1000000007;
        i = i + 1;
    }
    return checksum;
}

fn main() -> i32 {
    print_int(chacha20_checksum(1024));
    return 0;
}
