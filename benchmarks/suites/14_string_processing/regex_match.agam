@lang.advance

fn i64_const(value: i64) -> i64 { return value; }

fn regex_match(length: i64) -> i64 {
    let checksum: i64 = i64_const(0);
    
    // Pattern: "a*b+c?d" simplified to state machine
    let iter: i64 = i64_const(0);
    while iter < i64_const(100) {
        let state: i64 = i64_const(0); // i64_const(0): start/a*, i64_const(1): b+, i64_const(2): c?, i64_const(3): d (accept)
        let matches: i64 = i64_const(0);
        
        let i: i64 = i64_const(0);
        while i < length {
            let c: i64 = ((i * i64_const(17) + iter * i64_const(13)) % i64_const(5)) + i64_const(97); // 'a' through 'e'
            
            if state == i64_const(0) {
                if c == i64_const(97) {
                    state = i64_const(0);
                } else {
                    if c == i64_const(98) {
                        state = i64_const(1);
                    } else {
                        state = i64_const(0);
                    }
                }
            } else {
                if state == i64_const(1) {
                    if c == i64_const(98) {
                        state = i64_const(1);
                    } else {
                        if c == i64_const(99) {
                            state = i64_const(2);
                        } else {
                            if c == i64_const(100) {
                                state = i64_const(3);
                            } else {
                                state = i64_const(0);
                            }
                        }
                    }
                } else {
                    if state == i64_const(2) {
                        if c == i64_const(100) {
                            state = i64_const(3);
                        } else {
                            state = i64_const(0);
                        }
                    } else {
                        if state == i64_const(3) {
                matches = matches + i64_const(1);
                            if c == i64_const(98) {
                                state = i64_const(1);
                            } else {
                                state = i64_const(0);
                            }
                        }
                    }
                }
            }
            i = i + i64_const(1);
        }
        checksum = (checksum * i64_const(31) + matches) % i64_const(1000000007);
        iter = iter + i64_const(1);
    }
    return checksum;
}

fn main() -> i32 {
    print_int(regex_match(i64_const(10000)));
    return 0;
}
