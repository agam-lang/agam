@lang.advance

fn i64_const(value: i64) -> i64 { return value; }

fn json_parse(length: i64) -> i64 {
    let checksum: i64 = i64_const(0);
    
    let iter: i64 = i64_const(0);
    while iter < i64_const(100) {
        let state: i64 = i64_const(0); // i64_const(0): wait {, i64_const(1): wait key, i64_const(2): in key, i64_const(3): wait :, i64_const(4): wait val, i64_const(5): in val, i64_const(6): wait , or }
        let elements: i64 = i64_const(0);
        let depth: i64 = i64_const(0);
        
        let i: i64 = i64_const(0);
        while i < length {
            let c: i64 = ((i * i64_const(19) + iter * i64_const(7)) % i64_const(6));
            // Simulate: i64_const(0): '{', i64_const(1): '}', i64_const(2): '"', i64_const(3): ':', i64_const(4): ',', i64_const(5): 'a'
            if c == i64_const(0) {
                c = i64_const(123);
            } else {
                if c == i64_const(1) {
                    c = i64_const(125);
                } else {
                    if c == i64_const(2) {
                        c = i64_const(34);
                    } else {
                        if c == i64_const(3) {
                            c = i64_const(58);
                        } else {
                            if c == i64_const(4) {
                                c = i64_const(44);
                            } else {
                                c = i64_const(97);
                            }
                        }
                    }
                }
            }
            
            if state == i64_const(0) {
                if c == i64_const(123) {
                    state = i64_const(1);
                    depth = depth + i64_const(1);
                }
            } else {
                if state == i64_const(1) {
                    if c == i64_const(34) {
                        state = i64_const(2);
                    } else {
                        if c == i64_const(125) {
                            depth = depth - i64_const(1);
                            if depth == i64_const(0) {
                                state = i64_const(0);
                            } else {
                                state = i64_const(6);
                            }
                        }
                    }
                } else {
                    if state == i64_const(2) {
                        if c == i64_const(34) {
                            state = i64_const(3);
                        }
                    } else {
                        if state == i64_const(3) {
                            if c == i64_const(58) {
                                state = i64_const(4);
                            }
                        } else {
                            if state == i64_const(4) {
                                if c == i64_const(34) {
                                    state = i64_const(5);
                                } else {
                                    if c == i64_const(123) {
                                        state = i64_const(1);
                                        depth = depth + i64_const(1);
                                    }
                                }
                            } else {
                                if state == i64_const(5) {
                                    if c == i64_const(34) {
                                        state = i64_const(6);
                                        elements = elements + i64_const(1);
                                    }
                                } else {
                                    if state == i64_const(6) {
                                        if c == i64_const(44) {
                                            state = i64_const(1);
                                        } else {
                                            if c == i64_const(125) {
                                                depth = depth - i64_const(1);
                                                if depth == i64_const(0) {
                                                    state = i64_const(0);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            i = i + i64_const(1);
        }
        checksum = (checksum * i64_const(31) + elements + depth) % i64_const(1000000007);
        iter = iter + i64_const(1);
    }
    return checksum;
}

fn main() -> i32 {
    print_int(json_parse(i64_const(10000)));
    return 0;
}
