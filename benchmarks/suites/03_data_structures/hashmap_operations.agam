@lang.advance

fn i64_const(value: i64) -> i64 { return value; }

fn hashmap_probe_cost(slots: i64, rounds: i64) -> i64 {
    let mut total: i64 = i64_const(0);
    let mut round: i64 = i64_const(0);
    while round < rounds {
        let key: i64 = (round * i64_const(1103515245)) % i64_const(2147483647);
        let slot: i64 = key % slots;
        total = total + ((slot * i64_const(37)) % i64_const(4099));
        round = round + i64_const(1);
    }
    return total;
}

fn main() -> i32 {
    print_int(hashmap_probe_cost(i64_const(65536), i64_const(5000000)));
    return 0;
}
