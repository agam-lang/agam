@lang.advance

fn i64_const(value: i64) -> i64 { return value; }

fn conv_score(width: i64, height: i64) -> i64 {
    let total: i64 = i64_const(0);
    let y: i64 = i64_const(1);
    while y < height - i64_const(1) {
        let x: i64 = i64_const(1);
        while x < width - i64_const(1) {
            total = total + (((x * i64_const(3)) + (y * i64_const(5))) % i64_const(97));
            x = x + i64_const(1);
        }
        y = y + i64_const(1);
    }
    return total;
}
fn main() -> i32 { print_int(conv_score(i64_const(512), i64_const(512))); return 0; }
