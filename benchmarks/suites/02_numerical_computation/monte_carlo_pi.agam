@lang.advance

fn i64_const(value: i64) -> i64 { return value; }

fn monte_carlo(samples: i64) -> i64 {
    let inside: i64 = i64_const(0);
    let seed: i64 = i64_const(123456789);
    let i: i64 = i64_const(0);
    while i < samples {
        seed = ((seed * i64_const(1103515245)) + i64_const(12345)) % i64_const(2147483647);
        let x: i64 = seed % i64_const(10000);
        seed = ((seed * i64_const(1103515245)) + i64_const(12345)) % i64_const(2147483647);
        let y: i64 = seed % i64_const(10000);
        if (x * x) + (y * y) <= i64_const(100000000) {
            inside = inside + i64_const(1);
        }
        i = i + i64_const(1);
    }
    return (inside * i64_const(4000000)) / samples;
}

fn main() -> i32 {
    print_int(monte_carlo(i64_const(500000)));
    return 0;
}
