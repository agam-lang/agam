@lang.advance
fn i64_const(value: i64) -> i64 { return value; }

// Test: basic expression parsing — parenthesized, binary ops, unary minus.
fn main() -> i32 {
    let a: i64 = (i64_const(2) + i64_const(3)) * i64_const(4);
    let b: i64 = a - (i64_const(10) / i64_const(2));
    print_int(b);
    return 0;
}
