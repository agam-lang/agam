@lang.advance
fn i64_const(value: i64) -> i64 { return value; }

// Test: if/else, while loop parsing.
fn main() -> i32 {
    let x: i64 = i64_const(0);
    let i: i64 = i64_const(0);
    while i < i64_const(10) {
        if i % i64_const(2) == i64_const(0) { x = x + i; } else { x = x - i64_const(1); }
        i = i + i64_const(1);
    }
    print_int(x);
    return 0;
}
