@lang.advance
fn i64_const(value: i64) -> i64 { return value; }

// Test: nested loops with inner/outer interaction.
fn main() -> i32 {
    let total: i64 = i64_const(0);
    let i: i64 = i64_const(0);
    while i < i64_const(10) {
        let j: i64 = i64_const(0);
        while j < i {
            total = total + i64_const(1);
            j = j + i64_const(1);
        }
        i = i + i64_const(1);
    }
    print_int(total);
    return 0;
}
