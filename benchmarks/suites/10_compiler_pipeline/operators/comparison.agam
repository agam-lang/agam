@lang.advance
fn i64_const(value: i64) -> i64 { return value; }

// Test: comparison operators.
fn bool_to_int(cond: i64) -> i64 { return cond; }
fn main() -> i32 {
    let total: i64 = i64_const(0);
    if i64_const(5) < i64_const(10) { total = total + i64_const(1); }
    if i64_const(10) > i64_const(5) { total = total + i64_const(1); }
    if i64_const(5) <= i64_const(5) { total = total + i64_const(1); }
    if i64_const(7) >= i64_const(7) { total = total + i64_const(1); }
    if i64_const(3) == i64_const(3) { total = total + i64_const(1); }
    if i64_const(3) != i64_const(4) { total = total + i64_const(1); }
    print_int(total);
    return 0;
}
