@lang.advance

fn i64_const(value: i64) -> i64 { return value; }

fn block(seed: i64, width: i64) -> i64 {
    let total: i64 = i64_const(0);
    let i: i64 = i64_const(0);
    while i < width {
        total = total + (((seed * i64_const(31)) + i) % i64_const(4099));
        i = i + i64_const(1);
    }
    return total;
}
fn main() -> i32 {
    let total: i64 = i64_const(0);
    let stage: i64 = i64_const(0);
    while stage < i64_const(2000) {
        total = total + block(stage, i64_const(128));
        stage = stage + i64_const(1);
    }
    print_int(total);
    return 0;
}
