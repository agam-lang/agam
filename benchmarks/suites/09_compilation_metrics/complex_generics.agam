@lang.advance

fn i64_const(value: i64) -> i64 { return value; }

fn apply_twice(x: i64, step: i64) -> i64 {
    return ((x * step) + i64_const(7)) % i64_const(104729);
}
fn chain(x: i64, depth: i64) -> i64 {
    if depth == i64_const(0) { return x; }
    return chain(apply_twice(x, depth), depth - i64_const(1));
}
fn main() -> i32 {
    let total: i64 = i64_const(0);
    let i: i64 = i64_const(0);
    while i < i64_const(500) {
        total = total + chain(i, i64_const(20));
        i = i + i64_const(1);
    }
    print_int(total);
    return 0;
}
