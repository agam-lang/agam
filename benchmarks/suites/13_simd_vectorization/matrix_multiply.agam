@lang.advance

fn i64_const(value: i64) -> i64 { return value; }

fn matrix_multiply(size: i64) -> i64 {
    let checksum: i64 = i64_const(0);
    let s: i64 = size;
    
    let i: i64 = i64_const(0);
    while i < s {
        let j: i64 = i64_const(0);
        while j < s {
            let sum: i64 = i64_const(0);
            let k: i64 = i64_const(0);
            while k < s {
                let a: i64 = ((i * s + k) * i64_const(17) + i64_const(13)) % i64_const(256);
                let b: i64 = ((k * s + j) * i64_const(19) + i64_const(7)) % i64_const(256);
                sum = sum + a * b;
                k = k + i64_const(1);
            }
            checksum = (checksum * i64_const(31) + sum) % i64_const(1000000007);
            j = j + i64_const(1);
        }
        i = i + i64_const(1);
    }
    return checksum;
}

fn main() -> i32 {
    print_int(matrix_multiply(i64_const(64)));
    return 0;
}
