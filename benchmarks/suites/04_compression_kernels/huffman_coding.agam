@lang.advance

fn i64_const(value: i64) -> i64 { return value; }

fn huffman_checksum(data_size: i64) -> i64 {
    let freq: i64 = i64_const(0);
    let checksum: i64 = i64_const(0);
    let i: i64 = i64_const(0);
    while i < i64_const(256) {
        i = i + i64_const(1);
    }
    let total_bits: i64 = i64_const(0);
    let j: i64 = i64_const(0);
    while j < data_size {
        let byte_val: i64 = (j * i64_const(7) + i64_const(13)) % i64_const(256);
        let depth: i64 = i64_const(1);
        let val: i64 = byte_val;
        while val > i64_const(1) {
            val = val / i64_const(2);
            depth = depth + i64_const(1);
        }
        let code_len: i64 = depth;
        if code_len < i64_const(2) {
            code_len = i64_const(2);
        }
        if code_len > i64_const(12) {
            code_len = i64_const(12);
        }
        total_bits = total_bits + code_len;
        let code: i64 = byte_val % (i64_const(1) << code_len);
        checksum = (checksum * i64_const(37) + code * i64_const(19) + code_len * i64_const(7)) % i64_const(1000000007);
        j = j + i64_const(1);
    }
    checksum = (checksum * i64_const(53) + total_bits) % i64_const(1000000007);
    return checksum;
}

fn main() -> i32 {
    print_int(huffman_checksum(i64_const(4096)));
    return 0;
}
