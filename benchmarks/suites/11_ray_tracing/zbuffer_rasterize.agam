@lang.advance

fn i64_const(value: i64) -> i64 { return value; }

fn zbuffer_rasterize(triangles: i64) -> i64 {
    let width: i64 = i64_const(256);
    let height: i64 = i64_const(256);
    let checksum: i64 = i64_const(0);
    
    let t: i64 = i64_const(0);
    while t < triangles {
        let x0: i64 = (t * i64_const(17)) % width;
        let y0: i64 = (t * i64_const(19)) % height;
        let z0: i64 = (t * i64_const(23)) % i64_const(1000);
        
        let x1: i64 = (x0 + i64_const(50)) % width;
        let y1: i64 = (y0 + i64_const(20)) % height;
        let z1: i64 = (t * i64_const(29)) % i64_const(1000);
        
        let x2: i64 = (x0 + i64_const(20)) % width;
        let y2: i64 = (y0 + i64_const(50)) % height;
        let z2: i64 = (t * i64_const(31)) % i64_const(1000);
        
        let min_x: i64 = x0;
        if x1 < min_x { min_x = x1; }
        if x2 < min_x { min_x = x2; }
        
        let max_x: i64 = x0;
        if x1 > max_x { max_x = x1; }
        if x2 > max_x { max_x = x2; }
        
        let min_y: i64 = y0;
        if y1 < min_y { min_y = y1; }
        if y2 < min_y { min_y = y2; }
        
        let max_y: i64 = y0;
        if y1 > max_y { max_y = y1; }
        if y2 > max_y { max_y = y2; }
        
        let area: i64 = (x1 - x0) * (y2 - y0) - (x2 - x0) * (y1 - y0);
        if area == i64_const(0) { area = i64_const(1); }
        if area < i64_const(0) { area = -area; }
        
        let pixels_drawn: i64 = i64_const(0);
        
        let py: i64 = min_y;
        while py <= max_y {
            let px: i64 = min_x;
            while px <= max_x {
                let w0: i64 = (x1 - px) * (y2 - py) - (x2 - px) * (y1 - py);
                let w1: i64 = (x2 - px) * (y0 - py) - (x0 - px) * (y2 - py);
                let w2: i64 = (x0 - px) * (y1 - py) - (x1 - px) * (y0 - py);
                
                let is_inside: i64 = i64_const(0);
                if w0 >= i64_const(0) && w1 >= i64_const(0) && w2 >= i64_const(0) { is_inside = i64_const(1); }
                if w0 <= i64_const(0) && w1 <= i64_const(0) && w2 <= i64_const(0) { is_inside = i64_const(1); }
                
                if is_inside != i64_const(0) {
                    let z: i64 = (w0 * z0 + w1 * z1 + w2 * z2) / area;
                    pixels_drawn = pixels_drawn + i64_const(1);
                    checksum = (checksum * i64_const(31) + z + px + py) % i64_const(1000000007);
                }
                px = px + i64_const(1);
            }
            py = py + i64_const(1);
        }
        checksum = (checksum * i64_const(37) + pixels_drawn) % i64_const(1000000007);
        t = t + i64_const(1);
    }
    return checksum;
}

fn main() -> i32 {
    print_int(zbuffer_rasterize(i64_const(1024)));
    return 0;
}
